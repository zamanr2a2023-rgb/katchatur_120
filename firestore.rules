rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // App configuration is read-only from the client (defaults are used if reads fail).
    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Each user can read/write ONLY their own profile.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Donations are authoritative from Stripe webhook/backend only.
    match /donations/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Everything else: no access by default.
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}

